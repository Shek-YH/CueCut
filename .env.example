# CueCut local providers — leave blank until explicitly approved.
CUECUT_DIRECTOR_PROVIDER=
CUECUT_DIRECTOR_MODEL=qwen3.8-flash
CUECUT_DIRECTOR_TIMEOUT_MS=30000
CUECUT_ASR_PROVIDER=
CUECUT_ASR_MODEL=

# Visual asset generation is opt-in. Keep the API key in CueCut Settings,
# never in this file or the client bundle.
CUECUT_VISUAL_ASSET_PROVIDER=disabled
CUECUT_VISUAL_ASSET_ENDPOINT=
CUECUT_VISUAL_ASSET_MODEL=
