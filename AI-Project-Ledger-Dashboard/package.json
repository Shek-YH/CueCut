{
  "name": "ai-project-ledger-dashboard-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "tsx scripts/dev.mjs",
    "test": "vitest run",
    "test:focused": "vitest run tests/schema tests/progress tests/ui",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit --jsx react",
    "build": "tsc -p tsconfig.build.json && vite build"
  },
  "dependencies": {
    "chokidar": "4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "4.19.4",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
